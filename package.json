{
  "name": "web-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web institucional de S.I.M. (Servicios Integrales para Mascotas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
