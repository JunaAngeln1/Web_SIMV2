# Endpoint del servicio de formularios (Formspree / Netlify Forms / backend propio).
# Vacio = el formulario no envia y muestra el aviso de configuracion pendiente.
# Nunca subas el valor real de esta variable a git.
VITE_FORM_ENDPOINT=

# Google Maps JavaScript API; restrict the production key by HTTP referrer and API.
# Geocoding clinic coordinates is a separate one-time task; never geocode the full directory per page visit.
VITE_GOOGLE_MAPS_API_KEY=

# Geocoding inicial del directorio desde un script local; clave secreta, nunca VITE_ ni publicada.
GOOGLE_MAPS_GEOCODING_KEY=
